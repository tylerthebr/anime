{
  "name": "animejs",
  "version": "4.0.0",
  "description": "JavaScript animation engine",
  "main": "lib/anime.cjs.js",
  "module": "lib/anime.esm.js",
  "browser": "lib/anime.umd.js",
  "types": "lib/anime.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.js",
    "prepublishOnly": "npm run build",
    "sandbox": "node sandbox/index.js",
    "sandbox:watch": "node --watch sandbox/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/juliangarnier/anime.git"
  },
  "keywords": [
    "animation",
    "javascript",
    "css",
    "svg",
    "canvas",
    "anime"
  ],
  "author": "Julian Garnier",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/juliangarnier/anime/issues"
  },
  "homepage": "https://animejs.com",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^8.56.0",
    "jsdom": "^24.0.0",
    "rollup": "^4.9.5",
    "vitest": "^2.0.0"
  },
  "notes": "Personal fork for learning/experimenting with anime.js internals. Main branch tracks upstream. Added sandbox script for quick local testing. Added sandbox:watch for auto-reloading during experiments."
}
